@startuml
title Luồng Quản lý danh mục (Thêm danh mục)

actor User
participant "FrontendApp" as FE
participant "CategoryController" as Ctrl
participant "CategoryService" as Svc
participant "CategoryRepository" as Repo
database "MongoDB" as DB

User -> FE : Nhập tên danh mục, loại (income/expense/...), catalogId
FE -> Ctrl : POST /api/categories (data)
activate Ctrl

Ctrl -> Svc : addCategory(data)
activate Svc

Svc -> Svc : Kiểm tra tính đầy đủ của thông tin
Svc -> Repo : findUserById(userId)
activate Repo
Repo --> Svc : userExists
deactivate Repo

alt Người dùng không tồn tại
    Svc --> Ctrl : Throw AppError(404, 'Không tìm thấy tài khoản')
end

Svc -> Repo : findCategoryByName(userId, type, name)
activate Repo
Repo --> Svc : existingCategory
deactivate Repo

alt Trùng tên danh mục
    Svc --> Ctrl : Throw AppError(409, 'Trùng danh mục')
end

Svc -> Repo : findCatalogByIdAndType(catalogId, type)
activate Repo
Repo --> Svc : existingCatalog
deactivate Repo

alt Nhóm danh mục không khớp
    Svc --> Ctrl : Throw AppError(400, 'Không tìm thấy nhóm danh mục')
end

Svc -> Repo : addCategory({userId, name, type, catalogId})
activate Repo
Repo -> DB : Save to categories collection
DB --> Repo : savedCategory
Repo --> Svc : category object
deactivate Repo

Svc --> Ctrl : Return category
deactivate Svc

Ctrl --> FE : 201 Created {success: true, category}
deactivate Ctrl

FE -> User : Hiển thị danh mục mới / Cập nhật UI
@enduml
